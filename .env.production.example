# Copie para .env.production na VPS e restrinja as permissoes (chmod 600).
SITE_DOMAIN=loja.exemplo.com.br
ACME_EMAIL=admin@exemplo.com.br
PUBLIC_SITE_URL=https://loja.exemplo.com.br

# Use valores aleatorios, distintos e sem caracteres especiais de URL para POSTGRES_PASSWORD.
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_REPLICATION_PASSWORD=replace-with-another-long-random-password
REDIS_PASSWORD=replace-with-another-long-random-password
RABBITMQ_PASSWORD=replace-with-another-long-random-password

# Configure somente na primeira migracao; remova depois do bootstrap.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

SHIPPING_TOKEN=
SHIPPING_ORIGIN_CEP=
SHIPPING_USER_AGENT=
SHIPPING_ENVIRONMENT=production
PAYMENT_WEBHOOK_ENABLED=false
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

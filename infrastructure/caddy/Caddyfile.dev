{
  auto_https off
}
:80 {
  log {
    output stdout
    format json
  }
  @backend path /api/* /health/*
  handle @backend {
    reverse_proxy api-1:8080 api-2:8080 {
      lb_policy round_robin
      health_uri /health/ready
      health_interval 10s
      health_timeout 2s
      fail_duration 30s
      transport http {
        dial_timeout 2s
        response_header_timeout 15s
      }
    }
  }
  handle {
    reverse_proxy storefront:3000
  }
}

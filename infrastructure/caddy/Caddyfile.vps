{
  email {$ACME_EMAIL}
}
{$SITE_DOMAIN} {
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "DENY"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    -Server
  }
  @privateApi path /api/v1/account/* /api/v1/admin/* /api/v1/cart*
  header @privateApi Cache-Control "no-store"
  @accountPage path /conta /conta/*
  header @accountPage {
    Cache-Control "no-store"
    Referrer-Policy "no-referrer"
  }
  log {
    output stdout
    format json
  }
  @backend path /api/* /health/*
  handle @backend {
    reverse_proxy api:8080 {
      lb_policy round_robin
      health_uri /health/ready
      health_interval 10s
      health_timeout 2s
      fail_duration 30s
      transport http {
        dial_timeout 2s
        response_header_timeout 15s
      }
    }
  }
  handle {
    reverse_proxy storefront:3000 {
      lb_policy round_robin
      health_uri /robots.txt
      health_interval 10s
      health_timeout 2s
      fail_duration 30s
      transport http {
        dial_timeout 2s
        response_header_timeout 15s
      }
    }
  }
}
